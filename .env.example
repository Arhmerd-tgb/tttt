PORT=3001
NODE_ENV=development
TRUST_PROXY=0
CORS_ALLOWED_ORIGINS=
PUBLIC_APP_URL=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SIGNUP_CODE=
SESSION_TTL_HOURS=720
ALLOW_DEFAULT_ADMIN=false

PAYSTACK_SECRET_KEY=
